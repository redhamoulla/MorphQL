{
  "baseline_edge_fill": "backfill_then_forward_fill",
  "baseline_min_periods": 15,
  "baseline_operator": "centered_rolling_median",
  "baseline_window_days": 63,
  "causal": false,
  "config_kind": "preprocessing",
  "epsilon": 1e-06,
  "mad_consistency_factor": 1.4826,
  "normalization": "residual_divided_by_robust_scale",
